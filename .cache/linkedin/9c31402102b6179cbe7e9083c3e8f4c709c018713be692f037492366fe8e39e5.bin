    <script type="application/ld+json">
      {"@context":"http://schema.org","@graph":[{"@context":"http://schema.org","@type":"DiscussionForumPosting","author":{"@type":"Organization","name":"ALTA NÆRINGSFORENING","url":"https://no.linkedin.com/company/alta-n%C3%A6ringsforening"},"datePublished":"2026-08-25T11:19:08.207Z","headline":"Arrangement og markedsansvarlig","mainEntityOfPage":"https://no.linkedin.com/posts/alta-n%C3%A6ringsforening_ansette-activity-7497975849753767936-xcxJ","text":"Vi skal #ansette en ny Arrangement og markedsansvarlig i Alta, Troms og Finnmark. Søk i dag eller del dette innlegget med nettverket ditt.","url":"https://no.linkedin.com/posts/alta-n%C3%A6ringsforening_ansette-activity-7497975849753767936-xcxJ"},{"@context":"http://schema.org","@type":"DiscussionForumPosting","author":{"@type":"Organization","name":"ALTA NÆRINGSFORENING","url":"https://no.linkedin.com/company/alta-n%C3%A6ringsforening"},"datePublished":"2026-06-04T08:29:03.295Z","mainEntityOfPage":"https://no.linkedin.com/posts/alta-n%C3%A6ringsforening_hils-p%C3%A5-tina-hun-er-v%C3%A5r-nye-sommerstudent-activity-7468217242321711105-XVj5","text":"Hils på Tina! Hun er vår nye sommerstudent ☀️\n \nTina studerer Industriell økonomi og teknologiledelse ved NTNU Trondheim. Hun har tidligere bidratt på prosjekter hos næringsforeningen, blant annet Hjem til Jul 2025, og er nå tilbake hos oss denne sommeren.\n \nMed sin rykende ferske kompetanse fra akademia, får Tina testet ut teori i praksis. Hennes kunnskap bidrar med nye perspektiver som er svært verdifulle for oss i ANF.\n \nEn oppfordring fra oss er å ta inn sommerstudenter eller sommervikarer - dette er en viktig døråpner inn i arbeidslivet for de unge 💡","url":"https://no.linkedin.com/posts/alta-n%C3%A6ringsforening_hils-p%C3%A5-tina-hun-er-v%C3%A5r-nye-sommerstudent-activity-7468217242321711105-XVj5"},{"@context":"http://schema.org","@type":"DiscussionForumPosting","author":{"@type":"Organization","name":"ALTA NÆRINGSFORENING","url":"https://no.linkedin.com/company/alta-n%C3%A6ringsforening"},"datePublished":"2026-06-01T09:31:24.201Z","mainEntityOfPage":"https://no.linkedin.com/posts/alta-n%C3%A6ringsforening_tusen-takk-til-alle-som-bidro-og-deltok-p%C3%A5-activity-7467145769125486592-VAXW","text":"Tusen takk til alle som bidro og deltok på Industri- og kraftkonferansen🙌 En spesiell takk til våre samarbeidspartnere og sponsorer: \n \n⭐Arctic Energy Partners\n\n✨Statkraft ✨Finnmark fylkeskommune\n\n✨LO Norge ✨Energi i Nord ✨Equinor ✨Statnett SF ✨NHO Arktis ✨@iFinnmark.no\n\n✨ALTA KRAFTLAG SA ✨ Finnmark Kraft ✨ @Infranord ✨Jaro AS ✨Hammerfest Energi ✨Varanger Kraft\n\nEt tilbakeblikk fra to innholdsrike dager - ser du noen kjente?\n📸: Polarnatt","url":"https://no.linkedin.com/posts/alta-n%C3%A6ringsforening_tusen-takk-til-alle-som-bidro-og-deltok-p%C3%A5-activity-7467145769125486592-VAXW"},{"@context":"http://schema.org","@type":"DiscussionForumPosting","author":{"@type":"Organization","name":"ALTA NÆRINGSFORENING","url":"https://no.linkedin.com/company/alta-n%C3%A6ringsforening"},"datePublished":"2026-05-18T08:47:15.692Z","mainEntityOfPage":"https://no.linkedin.com/posts/alta-n%C3%A6ringsforening_vi-har-god-p%C3%A5melding-p%C3%A5-industri-og-kraftkonferansen-activity-7462061230384488448-vpEH","text":"\n👉Vi har god påmelding på Industri- og kraftkonferansen i Alta - det er fortsatt mulig å sikre seg en ledig plass nå: https://lnkd.in/dP9FAsAy","url":"https://no.linkedin.com/posts/alta-n%C3%A6ringsforening_vi-har-god-p%C3%A5melding-p%C3%A5-industri-og-kraftkonferansen-activity-7462061230384488448-vpEH"},{"@context":"http://schema.org","@type":"DiscussionForumPosting","author":{"@type":"Organization","name":"ALTA NÆRINGSFORENING","url":"https://no.linkedin.com/company/alta-n%C3%A6ringsforening"},"datePublished":"2026-05-13T14:48:37.234Z","mainEntityOfPage":"https://no.linkedin.com/posts/alta-n%C3%A6ringsforening_ig%C3%A5r-12-mai-hadde-vi-et-godt-oppm%C3%B8te-p%C3%A5-activity-7460340230034796544-iK7N","text":"Igår, 12. mai, hadde vi et godt oppmøte på årsmøte i Alta Næringsforening!🤩\n\nPå årsmøtet gikk Gunnar Ottesen formelt av som styreleder - etter å ha vært i rollen siden 2018! Før det var Gunnar styremedlem fra 2016. Vi takker for den lange innsatsen Gunnar, og lykke til videre!💐\n\nVi ønsker samtidig Veronika Andersen velkommen som ny styreleder – lykke til i rollen!🍀\n\nVi har også fått inn to nye styremedlemmer: Jessica Lien Johnsen og Silje Ingebrigtsen som nye styremedlemmer. Velkommen! \n\nTrykker du på lenken får du mer info om det nye styret og valgkomiteen: https://lnkd.in/e5p-ufzP","url":"https://no.linkedin.com/posts/alta-n%C3%A6ringsforening_ig%C3%A5r-12-mai-hadde-vi-et-godt-oppm%C3%B8te-p%C3%A5-activity-7460340230034796544-iK7N"},{"@context":"http://schema.org","@type":"Organization","name":"ALTA NÆRINGSFORENING","url":"https://no.linkedin.com/company/alta-n%C3%A6ringsforening","address":{"type":"PostalAddress","streetAddress":"Markedsgata 3","addressLocality":"Alta","addressRegion":"Finnmark","postalCode":"9510","addressCountry":"NO"},"description":"Alta Næringsforening er en medlemsorganisasjon som jobber for vekst og utvikling i Altas næringsliv og for å styrke byens attraktivitet som bosted. Vi ønsker å være en aktiv samarbeidspartner i både kommunale og private prosjekter som fremmer positiv utvikling for Alta og regionen. Gjennom vårt arbeid ønsker vi å gjøre det enda mer attraktivt å etablere og drive virksomhet i Alta.","numberOfEmployees":{"value":7,"@type":"QuantitativeValue"},"logo":{"contentUrl":"https://media.licdn.com/dms/image/v2/D4D0BAQHxJ9fP17_WjQ/company-logo_200_200/company-logo_200_200/0/1730276224225/alta_nringsforening_logo?e=2147483647&v=beta&t=NQo3U0MJtEma1XGzxiB6V0MEG4dIsf5W3FAWyjNWA2E","description":"ALTA NÆRINGSFORENING","@type":"ImageObject"},"slogan":"Vi samler næringslivet for vekst, utvikling og bolyst i Alta!","sameAs":"http://anf.no"}]}
    </script>
  
  
      
