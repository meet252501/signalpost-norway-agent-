# Copy this file to .env and fill in real values. Never commit .env itself.

# Optional paid search/lookup API, if used for candidate discovery
SEARCH_API_KEY=

# Optional LinkedIn-adjacent data provider, if used (confirm against
# source_policy.md before enabling)
COMPANY_DATA_API_KEY=

# Budget guardrails (enforced in src/storage / src/cli)
MAX_REQUESTS_PER_BATCH=2000
MAX_WALLCLOCK_SECONDS=2580
MAX_DECLARED_COST_USD=10

# Dev slice size for the learning harness
DEV_SLICE_SIZE=250
